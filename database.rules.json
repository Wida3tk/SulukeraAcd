{
  "rules": {
    ".read": "auth != null && root.child('users').child(auth.uid).exists()",
    ".write": false,
    "users": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "students": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "grades": { ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'lecturer')" },
    "lecturerFollowUps": { ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'lecturer')" },
    "studentRequests": {
      "$requestId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'lecturer' || (root.child('users').child(auth.uid).child('role').val() === 'student' && newData.child('studentKey').val() === root.child('users').child(auth.uid).child('studentKey').val()))"
      }
    },
    "activityLogs": { ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'lecturer')" },
    "subjects": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "enrollments": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "programs": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "packages": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "settings": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "semesters": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "curriculumTemplate": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "courseCatalog": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "schedule": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "examSchedules": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "studentExamExceptions": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "advisorCases": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "studentAdminSheets": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "certificateDrafts": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" },
    "lecturerProductivity": { ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'" }
  }
}
